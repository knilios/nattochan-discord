# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=698070844441624658
PREFIX=!

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Vector Database Configuration
# For local ChromaDB, use: http://localhost:8000
# For ChromaDB cloud, use your cloud URL (e.g., https://api.trychroma.com)
CHROMA_PATH=http://localhost:8000
CHROMA_COLLECTION=nattochan_memories
# Optional: ChromaDB Cloud authentication (leave empty for local)
CHROMA_API_KEY=
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database

# Scheduler Configuration
MEMORY_PROCESS_TIME=23:00
TIMEZONE=Asia/Bangkok

# Bot Settings
BOT_OWNER_ID=your_user_id_here
NODE_ENV=development
